<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom Gripper — Xacro Macro
  ==============================
  Converted from custom_gripper_pkg/urdf/gripper.urdf

  What changed from the standalone URDF:
    1. Wrapped everything in <xacro:macro> with params: parent, prefix, origin
    2. Added ${prefix} before every link and joint name (avoids name collisions)
    3. Added a gripper_base_joint to connect to the parent link (Link_06)
    4. REMOVED <ros2_control> block → handled in jaka_s12.ros2_control.xacro
    5. REMOVED <gazebo> plugin blocks → the robot's gz_ros2_control plugin
       (already in jaka_s12.urdf) covers all joints including gripper joints.
       gz_ros2_control handles mimic joints natively via ros2_control <param>.

  Sliding axis: X
    jaw_left  slides -X to open  (MASTER — commanded)
    jaw_right slides +X to open  (SLAVE  — mimics jaw_left × -1)
    Travel: 25 mm per jaw = 50 mm total openings
    TCP: 49 mm above body origin
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="custom_gripper" params="parent prefix:='' *origin">

    <!-- ============================================================
         MOUNTING JOINT — connects robot flange (Link_06) to gripper
         ============================================================ -->
    <joint name="${prefix}gripper_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="${prefix}gripper_base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${prefix}gripper_base_link"/>

    <!-- ============================================================
         BASE LINK → BODY (fixed offset from flange)
         ============================================================ -->
    <joint name="${prefix}gripper_base_to_body_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child  link="${prefix}gripper_body_link"/>
      <origin xyz="0.0 0.0 0.09" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- ============================================================
         WRIST FORCE-TORQUE SENSOR (Gazebo only)
         Measures the wrench between the flange and the gripper body. Its torque
         about the tool axis (body z = grasp_tcp z) is the nut tightening torque.
         Needed because gz_ros2_control (Humble) reports joint effort as NaN.
         preserveFixedJoint keeps this fixed joint in the SDF (fixed joints are
         otherwise merged), so the sensor has a joint to measure. Gazebo also needs
         the ForceTorque system as a WORLD plugin (see worlds/world.sdf for why).
         Topic: /wrist_ft (ignition.msgs.Wrench), bridged to ROS as WrenchStamped.
         ============================================================ -->
    <gazebo reference="${prefix}gripper_base_to_body_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
      <sensor name="wrist_ft" type="force_torque">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/wrist_ft</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </gazebo>

    <!-- ============================================================
         BODY
         ============================================================ -->
    <link name="${prefix}gripper_body_link">
      <inertial>
        <origin xyz="0.01625 0.0 -0.03925" rpy="0.0 0.0 0.0"/>
        <mass value="0.5"/>
        <inertia ixx="0.00200" iyy="0.00200" izz="0.00150"
                 ixy="0.0"    iyz="0.0"    ixz="0.0"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://custom_gripper_pkg/meshes/body.STL"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="gripper_grey">
          <color rgba="0.65 0.65 0.65 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.01625 0.0 -0.03925" rpy="0.0 0.0 0.0"/>
        <geometry>
          <box size="0.1075 0.075 0.1055"/>
        </geometry>
      </collision>
    </link>

    <gazebo reference="${prefix}gripper_body_link">
      <material>Gazebo/Black</material>
    </gazebo>

    <!-- ============================================================
         JAW LEFT — MASTER prismatic joint
         Slides in -X to open, 0 = closed
         ============================================================ -->
    <joint name="${prefix}gripper_jaw_left_joint" type="prismatic">
      <parent link="${prefix}gripper_body_link"/>
      <child  link="${prefix}gripper_jaw_left_link"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <axis xyz="1.0 0.0 0.0"/>
      <limit lower="-0.026" upper="0.001" effort="50.0" velocity="0.05"/>
      <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <link name="${prefix}gripper_jaw_left_link">
      <inertial>
        <origin xyz="0.01499 -0.00425 0.0265" rpy="0.0 0.0 0.0"/>
        <mass value="0.05"/>
        <inertia ixx="3.0e-05" iyy="3.0e-05" izz="1.5e-05"
                 ixy="0.0"    iyz="0.0"    ixz="0.0"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://custom_gripper_pkg/meshes/jaw_left.STL"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="gripper_dark">
          <color rgba="0.25 0.25 0.25 1.0"/>
        </material>
      </visual>
      <!-- Collision = two convex boxes fitted to jaw_left.STL (measured from the mesh):
           finger pad x 24.5..33.5 mm, y +-5.5 mm, z 24.0..49.0 mm (the only part that
           touches the nut), and the rail block x -7.0..37.0, y -14.0..5.5, z 4.0..23.9 mm.
           Mesh-vs-mesh contact was the grasp failure: with Bullet it never registers,
           with FCL it is sparse/jittery and the nut slips. The pad box does not reach
           the opposite pad until q = -0.0245 (49 mm open gap), unlike the old single box. -->
      <collision name="jaw_left_pad">
        <origin xyz="0.0290 0.0 0.0365" rpy="0.0 0.0 0.0"/>
        <geometry>
          <box size="0.0090 0.0110 0.0250"/>
        </geometry>
      </collision>
      <collision name="jaw_left_rail">
        <origin xyz="0.0150 -0.00425 0.01395" rpy="0.0 0.0 0.0"/>
        <geometry>
          <box size="0.0440 0.0195 0.0199"/>
        </geometry>
      </collision>
    </link>

    <gazebo reference="${prefix}gripper_jaw_left_link">
      <material>Gazebo/DarkGrey</material>
      <kp>5000000.0</kp>
      <kd>500.0</kd>
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
      <minDepth>0.002</minDepth>
      <maxVel>0.005</maxVel>
    </gazebo>

    <!-- ============================================================
         JAW RIGHT — SLAVE mimic joint
         Slides in +X automatically when jaw_left moves
         ============================================================ -->
    <joint name="${prefix}gripper_jaw_right_joint" type="prismatic">
      <parent link="${prefix}gripper_body_link"/>
      <child  link="${prefix}gripper_jaw_right_link"/>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <axis xyz="1.0 0.0 0.0"/>
      <limit lower="-0.001" upper="0.026" effort="50.0" velocity="0.05"/>
      <mimic joint="${prefix}gripper_jaw_left_joint" multiplier="-1" offset="0"/>
      <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <link name="${prefix}gripper_jaw_right_link">
      <inertial>
        <origin xyz="-0.01499 0.00425 0.0265" rpy="0.0 0.0 0.0"/>
        <mass value="0.05"/>
        <inertia ixx="3.0e-05" iyy="3.0e-05" izz="1.5e-05"
                 ixy="0.0"    iyz="0.0"    ixz="0.0"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://custom_gripper_pkg/meshes/jaw_right.STL"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="gripper_dark"/>
      </visual>
      <!-- Mirror of the left jaw boxes (fitted to jaw_right.STL). -->
      <collision name="jaw_right_pad">
        <origin xyz="-0.0290 0.0 0.0365" rpy="0.0 0.0 0.0"/>
        <geometry>
          <box size="0.0090 0.0110 0.0250"/>
        </geometry>
      </collision>
      <collision name="jaw_right_rail">
        <origin xyz="-0.0150 0.00425 0.01395" rpy="0.0 0.0 0.0"/>
        <geometry>
          <box size="0.0440 0.0195 0.0199"/>
        </geometry>
      </collision>
    </link>

    <gazebo reference="${prefix}gripper_jaw_right_link">
      <material>Gazebo/DarkGrey</material>
      <kp>5000000.0</kp>
      <kd>500.0</kd>
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
      <minDepth>0.002</minDepth>
      <maxVel>0.005</maxVel>
    </gazebo>

    <!-- ============================================================
         TCP — Tool Center Point at the top of the jaws
         X = 0.0   (symmetric between both jaws)
         Y = 0.0   (symmetric between both jaws)
         Z = 0.049 (top of jaws = 49 mm above body origin)
         ============================================================ 
    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}gripper_body_link"/>
      <child  link="${prefix}tcp"/>
      <origin xyz="0.0 0.0 0.049" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="${prefix}tcp"/>
    -->

    <!-- ============================================================
         GRASP TCP — pinch-center frame used for grasp planning
         X = 0.0    (centered between jaws)
         Y = 0.0    (centered between jaws)
         Z = 0.0265 (middle of jaw contact region)
         ============================================================ -->
    <joint name="${prefix}grasp_tcp_joint" type="fixed">
      <parent link="${prefix}gripper_body_link"/>
      <child  link="${prefix}grasp_tcp"/>
      <origin xyz="0.0 0.0 0.0265" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="${prefix}grasp_tcp"/>

  </xacro:macro>

</robot>
