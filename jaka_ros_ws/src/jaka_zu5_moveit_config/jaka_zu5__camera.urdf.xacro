<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jaka_zu5">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="ros2_control_hardware_type" default="mock_components" />
    <xacro:property name="PI" value="3.14159274"/>
    <xacro:arg name="use_gazebo" default="true"/>
    <xacro:arg name="use_rviz_sim" default="true"/>

    <!-- Import jaka_zu5 urdf file -->
    <xacro:include filename="$(find jaka_description)/urdf/jaka_zu5.urdf" />
    <!-- ADD Import jaka_zu5 urdf file -->
    <!-- <xacro:include filename="$(find jaka_description)/urdf/camera/camera.xacro"/> -->
    <xacro:include filename="$(find jaka_description)/urdf/camera/d455_camera.xacro"/>
    <!-- Update above line to this Import jaka_zu5 urdf file -->
    <!-- <xacro:include filename="$(find realsense2_description)/urdf/_d415.urdf.xacro"/> -->

   
    <!-- web ADDCamera -->
   
    <xacro:d455_camera_v0 parent="Link_0">
	    <origin xyz="0.2 0.6 0.7" rpy="0 ${PI/2} 0"/>
    </xacro:d455_camera_v0>


    <!-- Import control_xacro -->
    <xacro:include filename="jaka_zu5.ros2_control.xacro" />


    <!-- controllers for gazebo -->
    <xacro:jaka_zu5_ros2_control name="jaka_zu5_hardware" initial_positions_file="$(arg initial_positions_file)" use_gazebo="$(arg use_gazebo)" use_rviz_sim="$(arg use_rviz_sim)" />

</robot>
