<?xml version="1.0"?>
<sdf version="1.9">
  <model name="hex_nut">
    <static>false</static>
    <!-- The STL already has its bottom face at z=0, so keep the model origin
         at the contact surface and place nuts on the table from the world file. -->
    <pose>0 0 0 0 0 0</pose>
    
    <link name="nut_body">
      <pose>0 0 0 0 0 0</pose>
      
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      
      <!-- Use the real nut mesh for collision so the gripper contacts the
           flats and top surface instead of a rough solid cylinder. -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://nut/meshes/nut.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>10000000</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      
      <!-- Keep visual and collision on the same mesh/origin. Also avoid the
           Collada 1.5 warning by using STL instead of the invalid DAE file. -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://nut/meshes/nut.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <!-- A slightly darker, rougher zinc finish gives the RGB cameras
             better edge contrast than the previous near-white material. -->
        <material name="matte_zinc">
                <ambient>0.20 0.21 0.23 1</ambient>
                <diffuse>0.42 0.45 0.49 1</diffuse>
                <specular>0.08 0.08 0.08 1</specular>
                <emissive>0.015 0.015 0.018 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
