<?xml version="1.0"?>
<sdf version="1.9">
  <model name="hex_nut">
    <static>false</static>
    <!-- The STL already has its bottom face at z=0, so keep the model origin
         at the contact surface and place nuts on the table from the world file. -->
    <pose>0 0 0 0 0 0</pose>
    
    <link name="nut_body">
      <pose>0 0 0 0 0 0</pose>
      
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      
      <!-- Collision = exact DIN 934 M20 hexagonal prism built from three convex boxes:
           a regular hexagon is the union of three 30 mm (across flats) x 17.32 mm (edge
           length) rectangles rotated 0/60/120 deg; 16 mm tall, bottom at z = 0, matching
           nut.stl (corners on +-x, flats normal to +-y, +-30 deg, +-150 deg).
           Why not the mesh: Bullet cannot collide two triangle meshes and FCL mesh contact
           was sparse, so the nut slipped. Why not a cylinder: pad-vs-cylinder is a single
           contact line per jaw, the nut pivoted ~10 deg and fell during transport.
           Box faces give face-to-face pad contact on the flats. Visual keeps the mesh. -->
      <collision name="collision_flats_90">
        <pose>0 0 0.008 0 0 0</pose>
        <geometry>
          <box><size>0.01732 0.030 0.016</size></box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>10000000</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="collision_flats_150">
        <pose>0 0 0.008 0 0 1.0471975512</pose>
        <geometry>
          <box><size>0.01732 0.030 0.016</size></box>
        </geometry>
        <surface>
          <contact><ode><kp>10000000</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <collision name="collision_flats_30">
        <pose>0 0 0.008 0 0 2.0943951024</pose>
        <geometry>
          <box><size>0.01732 0.030 0.016</size></box>
        </geometry>
        <surface>
          <contact><ode><kp>10000000</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>

      <!-- Visual keeps the real mesh. Use STL instead of the invalid DAE file
           to avoid the Collada 1.5 warning. -->
      <visual name="visual">
        <cast_shadows>true</cast_shadows>
        <transparency>0.0</transparency>
        <geometry>
          <mesh>
            <uri>model://nut/meshes/nut.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <!-- A slightly darker, rougher zinc finish gives the RGB cameras
             better edge contrast than the previous near-white material. -->
        <material name="matte_zinc">
                <ambient>0.16 0.17 0.18 1</ambient>
                <diffuse>0.50 0.53 0.58 1</diffuse>
                <specular>0.18 0.18 0.18 1</specular>
                <emissive>0.010 0.010 0.012 1</emissive>
                <pbr>
                  <metal>
                    <metalness>0.35</metalness>
                    <roughness>0.72</roughness>
                  </metal>
                </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
