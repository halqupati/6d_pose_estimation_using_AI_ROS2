<?xml version="1.0"?>
<!--
  M20 bolt fixture, EMPTY (no nut). Tightening task.

  Model frame = table surface under the bolt axis (place it with z = table top).
    fixture plate : 100 x 100 x 20 mm, top face at z = 0.020  -> the SEAT
    bolt shank    : M20, 20 mm diameter, top at z = 0.040 (only 4 mm above a seated
                    16 mm nut, so the bolt end stays clear of the gripper's jaw rails,
                    which sit ~25 mm above the fingertips)

  Why empty: Gazebo cannot create a screw joint while the simulation runs. The nut
  therefore gets its thread from bin_packing_pkg/scripts/bolt_fixture_manager.py, which
  replaces this model by an identical fixture that also contains a nut and the screw
  joint (docs/tightening/phase0_screw_thread.md):
    /bolt_fixture/engage_nut  : a free nut placed on the bolt tip "catches the thread"
    /bolt_fixture/preload_nut : a nut already threaded 3 turns above the seat
  Keep the dimensions here and in bolt_fixture_manager.py identical.
-->
<sdf version="1.9">
  <model name="bolt_m20">
    <static>false</static>

    <link name="bolt">
      <inertial>
        <mass>2.0</mass>
        <inertia><ixx>2e-3</ixx><iyy>2e-3</iyy><izz>3e-3</izz></inertia>
      </inertial>
      <collision name="plate">
        <pose>0 0 0.010 0 0 0</pose>
        <geometry><box><size>0.10 0.10 0.020</size></box></geometry>
      </collision>
      <visual name="plate_visual">
        <pose>0 0 0.010 0 0 0</pose>
        <geometry><box><size>0.10 0.10 0.020</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.25 1</ambient>
          <diffuse>0.35 0.38 0.42 1</diffuse>
        </material>
      </visual>
      <collision name="shank">
        <pose>0 0 0.030 0 0 0</pose>
        <geometry><cylinder><radius>0.010</radius><length>0.020</length></cylinder></geometry>
      </collision>
      <visual name="shank_visual">
        <pose>0 0 0.030 0 0 0</pose>
        <geometry><cylinder><radius>0.010</radius><length>0.020</length></cylinder></geometry>
        <material>
          <ambient>0.30 0.30 0.30 1</ambient>
          <diffuse>0.60 0.60 0.62 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Weld the fixture to the world (it is clamped to the table). -->
    <joint name="fixture_fixed" type="fixed">
      <parent>world</parent>
      <child>bolt</child>
    </joint>
  </model>
</sdf>
