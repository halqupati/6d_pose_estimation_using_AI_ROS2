<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="empty_world">
    
    <!-- Physics -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

 
    <!-- Light -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.62 0.62 0.64 1</diffuse>
      <specular>0.06 0.06 0.06 1</specular>
      <direction>-0.35 0.18 -0.92</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Focused light above the pick zone so the nut flats and bore stay
         readable for RGB-based YOLO and AAE inference. -->
    <light name="pick_zone_key_light" type="spot">
      <pose>-0.50 0.55 1.85 0 0 0</pose>
      <diffuse>0.95 0.96 1.00 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <cast_shadows>false</cast_shadows>
      <direction>0.02 0.00 -1.0</direction>
      <attenuation>
        <range>3.0</range>
        <constant>0.8</constant>
        <linear>0.10</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0.40</inner_angle>
        <outer_angle>0.75</outer_angle>
        <falloff>0.35</falloff>
      </spot>
    </light>
    

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <pose>0 0 0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>50 50 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>50 50 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

     <!-- Table -->
    <include>
        <uri>file:///home/ubuntu/.ignition/fuel/fuel.gazebosim.org/openrobotics/models/table</uri>
        <name>table_1</name>
        <pose>0 0 0.0 0 0 0</pose>
    </include>
    <include>
        <uri>file:///home/ubuntu/.ignition/fuel/fuel.gazebosim.org/openrobotics/models/table</uri>
        <name>table_2</name>
        <pose>0 0.81 0.0 0 0 0</pose>
    </include>
    
    <include>
        <uri>model://checkerboard_plane</uri>
        <name>checkerboard plane</name>
        <pose>0.4 1.0 1.03 0 0 0</pose>
    </include>

    <model name="nut1">
      <include>
        <uri>model://nut</uri>
      </include>
      <pose>-0.60 0.49 1.015 0 0 1.50</pose>
    </model>

    <model name="nut2">
      <include>
        <uri>model://nut</uri>
      </include>
      <pose>-0.50 0.52 1.015 0 0 0.35</pose>
    </model>

    <model name="nut3">
      <include>
        <uri>model://nut</uri>
      </include>
      <pose>-0.40 0.58 1.015 0 0 -0.60</pose>
    </model>

    <model name="nut4">
      <include>
        <uri>model://nut</uri>
      </include>
      <pose>-0.50 0.57 1.015 0 0 0.90</pose>
    </model>

   
    
  </world>
</sdf>
