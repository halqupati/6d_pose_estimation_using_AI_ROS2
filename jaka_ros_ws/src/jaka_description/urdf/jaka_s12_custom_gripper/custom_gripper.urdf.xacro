<?xml version="1.0"?>
<!--
  Custom Gripper — JAKA S12 attachment wrapper
  =============================================
  Includes the custom gripper macro and attaches it to Link_06
  (the tool flange of the JAKA S12 arm).

  This file is included by jaka_s12.urdf via:
    <xacro:include filename="$(find jaka_description)/urdf/jaka_s12_custom_gripper/custom_gripper.urdf.xacro"/>
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="custom_gripper_for_jaka_s12">

  <xacro:include filename="$(find jaka_description)/urdf/jaka_s12_custom_gripper/custom_gripper_macro.urdf.xacro"/>

  <!-- Attach custom gripper to Link_06 with no offset (flush mount) -->
  <xacro:custom_gripper parent="Link_06" prefix="">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </xacro:custom_gripper>

</robot>
