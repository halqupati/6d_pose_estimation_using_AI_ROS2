<?xml version="1.0"?>
<!--
  ros2_control hardware interfaces for JAKA S12 + Custom Gripper
  ==============================================================
  Declares:
    - 6 arm joints (joint_1 … joint_6) with position command + state
    - jaw_left_joint  : master prismatic joint (position command + state)
    - jaw_right_joint : slave mimic joint (state only, follows jaw_left × -1)

  Hardware plugin selection (set via launch args):
    use_gazebo=true   → gz_ros2_control/GazeboSimSystem  (Ignition Gazebo)
    use_rviz_sim=true → mock_components/GenericSystem     (RViz-only testing)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="prefix" default=""/>

    <xacro:macro name="jaka_s12_ros2_control" params="
        name
        initial_positions_file
        use_gazebo
        use_rviz_sim:=false
        prefix
        sim_ignition:=true
        use_fake_hardware:=false
        mock_sensor_commands:=false">

        <xacro:property name="initial_positions"
            value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">

            <!-- Hardware plugin -->
            <hardware>
                <xacro:if value="${use_gazebo}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:if value="${use_rviz_sim}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
            </hardware>

            <!-- ── Arm joints ( Joint interfaces generated for each joint of ARM) ─────────────────────────────────────────── -->
            <joint name="joint_1">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_2">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_3">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_4">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint_4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_5">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint_5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_6">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint_6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>


            <!-- ── Custom gripper joints ──────────────────────────────── -->
            <!-- jaw_left is the MASTER joint: commanded via position interface.
                 jaw_right is a mimic joint whose relationship is declared in
                 the URDF via the <mimic> tag. ros2_control (Humble+) auto-
                 detects the mimic relationship from the URDF, so the legacy
                 <param name="mimic"> / <param name="multiplier"> block must
                 NOT be used here — otherwise gz_ros2_control registers a
                 duplicate state interface named "<joint>_mimic", which breaks
                 MoveIt's robot_model lookup.
                 See ros-controls/gazebo_ros2_control#173 -->

            <joint name="${prefix}gripper_jaw_left_joint">
                <command_interface name="position">
                    <param name="min">-0.026</param>
                    <param name="max">0.001</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

            <!-- jaw_right: no command_interface (mimic joint, command-less) -->
            <joint name="${prefix}gripper_jaw_right_joint">
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
