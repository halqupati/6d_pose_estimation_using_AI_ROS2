<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic Robot Description Format (SRDF) — JAKA S12 + Custom Gripper
  ======================================================================
  Planning groups:
    jaka_s12 : 6-DOF arm  (joint_1 … joint_6)
    gripper  : custom 2-finger jaw  (jaw_left_joint)

  End effector:
    gripper_eef → tcp link, parent group = jaka_s12
-->
<robot name="jaka_s12">

    <!-- ── Planning groups ─────────────────────────────────────────── -->
    <group name="jaka_s12">
        <joint name="fixed"/>
        <joint name="joint_1"/>
        <joint name="joint_2"/>
        <joint name="joint_3"/>
        <joint name="joint_4"/>
        <joint name="joint_5"/>
        <joint name="joint_6"/>
    </group>

    <group name="gripper">
        <joint name="gripper_jaw_left_joint"/>
    </group>

    <!-- ── Named states ────────────────────────────────────────────── -->
    <group_state name="zero" group="jaka_s12">
        <joint name="joint_1" value="0"/>
        <joint name="joint_2" value="0"/>
        <joint name="joint_3" value="0"/>
        <joint name="joint_4" value="0"/>
        <joint name="joint_5" value="0"/>
        <joint name="joint_6" value="0"/>
    </group_state>

    <group_state name="pose_1" group="jaka_s12">
        <joint name="joint_1" value="0"/>
        <joint name="joint_2" value="1.5707"/>
        <joint name="joint_3" value="-1.5707"/>
        <joint name="joint_4" value="1.5707"/>
        <joint name="joint_5" value="1.5707"/>
        <joint name="joint_6" value="0"/>
    </group_state>

    <!-- Gripper open: jaw_left at -25 mm (full travel) -->
    <group_state name="gripper_open" group="gripper">
        <joint name="gripper_jaw_left_joint" value="-0.025"/>
    </group_state>

    <!-- Gripper closed: jaw_left at 0 mm -->
    <group_state name="gripper_closed" group="gripper">
        <joint name="gripper_jaw_left_joint" value="0"/>
    </group_state>

    <!-- ── End effector ────────────────────────────────────────────── -->
    <!--
      The TCP link is the MoveIt planning target when picking objects.
      parent_group = jaka_s12 so IK solves for the arm to reach a pose.
    -->
    <end_effector name="gripper_eef"
                  parent_link="Link_06"
                  group="gripper"
                  parent_group="jaka_s12"/>

    <!-- ── Disabled collisions ─────────────────────────────────────── -->
    <!-- Arm links -->
    <disable_collisions link1="Link_01" link2="Link_02"      reason="Adjacent"/>
    <disable_collisions link1="Link_01" link2="Link_04"      reason="Never"/>
    <disable_collisions link1="Link_01" link2="base_link"    reason="Adjacent"/>
    <disable_collisions link1="Link_02" link2="Link_03"      reason="Adjacent"/>
    <disable_collisions link1="Link_03" link2="Link_04"      reason="Adjacent"/>
    <disable_collisions link1="Link_04" link2="Link_05"      reason="Adjacent"/>
    <disable_collisions link1="Link_04" link2="Link_06"      reason="Never"/>
    <disable_collisions link1="Link_05" link2="Link_06"      reason="Adjacent"/>

    <!-- Gripper mount chain -->
    <disable_collisions link1="Link_06"          link2="gripper_base_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="gripper_body_link"             reason="Adjacent"/>
    <disable_collisions link1="gripper_body_link"             link2="gripper_jaw_left_link"          reason="Adjacent"/>
    <disable_collisions link1="gripper_body_link"             link2="gripper_jaw_right_link"         reason="Adjacent"/>

    <!-- Gripper links never collide with upper arm -->
    <disable_collisions link1="Link_05" link2="gripper_base_link" reason="Never"/>
    <disable_collisions link1="Link_05" link2="gripper_body_link"              reason="Never"/>
    <disable_collisions link1="Link_05" link2="gripper_jaw_left_link"          reason="Never"/>
    <disable_collisions link1="Link_05" link2="gripper_jaw_right_link"         reason="Never"/>
    <disable_collisions link1="Link_06" link2="gripper_body_link"              reason="Never"/>
    <disable_collisions link1="Link_06" link2="gripper_jaw_left_link"          reason="Never"/>
    <disable_collisions link1="Link_06" link2="gripper_jaw_right_link"         reason="Never"/>

</robot>
