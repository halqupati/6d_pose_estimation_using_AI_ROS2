<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="arm_and_table">
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/> 
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <shadows>0</shadows>
    </scene>

    <gui>
      <camera name="user_camera">
        <pose>0.75 -0.75 1.4 0 0.29 2.21</pose>
      </camera>
    </gui>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="table">
      <static>true</static>
      <include>
        <uri>model://table</uri>
      </include>
      <pose>0.29 0 0 0 0 1.5708</pose>
    </model>

     <model name="nut1">
      <include>
        <uri>model://nut</uri>
      </include>
      <pose>0.5 0.35 1.05 1.5 1.5 1.5</pose>
    </model>

    <model name="nut2">
      <include>
        <uri>model://nut</uri>
      </include>
      <pose>0.25 0.35 1.05 0 0 0</pose>
    </model>

    <model name="nut3">
      <include>
        <uri>model://nut</uri>
      </include>
      <pose>0.11 0.35 1.05 0 0 0</pose>
    </model>

    <model name="nut4">
      <include>
        <uri>model://nut</uri>
      </include>
      <pose>0.5 0.5 1.05 0 0 0</pose>
    </model>

    <model name="ground_plane">
      <static>true</static>
      <include>
        <uri>model://ground_plane</uri>
      </include>
    </model>
  </world>
</sdf>